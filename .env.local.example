NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (Supabase Settings > API Keys > Secret keys), used only by
# the server-side reminders cron route to read across all users.
SUPABASE_SECRET_KEY=your-secret-key

# Daily reminder emails, sent via Resend (resend.com).
RESEND_API_KEY=your-resend-api-key
# Optional: only works once you verify a domain on Resend. Until then, leave
# unset and emails send from the shared onboarding@resend.dev address.
REMINDER_FROM_EMAIL="track.perso <onboarding@resend.dev>"

# Protects /api/cron/reminders from being called by anyone else.
CRON_SECRET=a-long-random-string
